# Copy this file to .env and add your real MongoDB connection strings.
# Keep .env private; never commit it or share it.

# Production source/target connection
MONGODB_PRODUCTION_URI="mongodb://<PRODUCTION_USERNAME>:<URL_ENCODED_PASSWORD>@<PRODUCTION_HOST>:27017/?authSource=<AUTH_DATABASE>"

# Development source/target connection
MONGODB_DEVELOPMENT_URI="mongodb+srv://<DEVELOPMENT_USERNAME>:<URL_ENCODED_PASSWORD>@<DEVELOPMENT_HOST>/?retryWrites=true&w=majority"

# Database names (edit if your environments use different names)
MONGODB_PRODUCTION_DB="roswalt_realty_db"
MONGODB_DEVELOPMENT_DB="rosewalt_realty_db"

# Only collections whose names start with this exact prefix are exported/imported.
# Change this one value for another dataset, e.g. plactu, start, crm.
COLLECTION_PREFIX="plactu"

# Export output directory
EXPORT_DIR="./exports"
